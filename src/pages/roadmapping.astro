---
import Offering from '../layouts/Offering.astro';
import { casesById } from '../data/cases.js';

const quote = casesById.asana.quote;
---
<Offering offering="roadmapping">
  <section class="block" slot="extra">
    <div class="wrap">
      <div class="sec-head">
        <div><span class="label accent">Featured case</span><h2>Asana</h2></div>
        <a class="more" href="/work.html#asana">Read the case &rarr;</a>
      </div>
      <div style="display:grid;gap:32px">
        <div class="prose"><p>Asana's value proposition was not well defined, and GPT-3 overturned the plans that were in place. Over nine months we worked through the landscape, the options, and the capabilities to build, together with the Head of Market Strategy. Asana repositioned itself around the Coordination Layer.</p></div>
        {quote && (
          <div class="quote">
            <blockquote>"{quote.text}"</blockquote>
            <cite>{quote.by}</cite>
          </div>
        )}
      </div>
    </div>
  </section>
</Offering>